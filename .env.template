# Production Environment Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Configuration
# =============================================================================
API_SECRET_KEY=your-secure-api-secret-key-here
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# =============================================================================
# External Service API Keys
# =============================================================================

# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone Configuration (Required)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_ENVIRONMENT=gcp-starter

# LlamaParse Configuration (Required)
LLAMA_PARSE_API_KEY=llx-your-llama-parse-api-key-here

# Firecrawl Configuration (Required for website ingestion)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here

# =============================================================================
# Database Configuration
# =============================================================================

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=kb_files

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Processing Configuration
# =============================================================================

# File Processing
MAX_FILE_SIZE_MB=25
TEMP_DIR=/tmp

# Text Processing
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

# Job Processing
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_MINUTES=30

# =============================================================================
# Development Overrides (uncomment for development)
# =============================================================================
# ENVIRONMENT=development
# LOG_FORMAT=text
# LOG_LEVEL=DEBUG
# API_HOST=localhost